# To apply to svn, type: 'svn propset svn:ignore -F .gitignore .'
# ... the caveat is you'd need a .gitignore in each subfolder
#
# Ignore the basin data (since it is in svn)
/parm/README.md
/parm/bnt/?basins.dta
/parm/bnt/basins.dta
/parm/bnt/sloshdsp.bnt
/parm/dta/*dta
/parm/dta/etss/*dta
/parm/tidefile.ec2014/*.gz
/parm/tidefile.ec2014/*.adj
/parm/tidefile.ec2014/*.bhc
/parm/tidefile.ec2014/tide_*.txt
/parm/tidefile.ec2014/ft03.dta
/parm/tidefile.ec2014/etss/*.gz
/parm/tidefile.ec2014/etss/*.adj
/parm/tidefile.ec2014/etss/*.bhc
#
# Ignore .o and exec files in sorc
/sorc/envutil.cd/*.o
/sorc/rexout.cd/*.o
/sorc/slosh.fd/*.o
/sorc/stm2trk.cd/*.o
#
# Ignore compiled executables for which we have source code
/exec/envutil
/exec/envutil.exe
/exec/rexout
/exec/rexout.exe
/exec/slosh
/exec/slosh_mpi
/exec/sloshDos.exe
/exec/sloshLinux
/exec/stm2trk.exe
/exec/stm2trk
#
# Ignore /work in dev
/dev/log/*
/dev/workActive/*
/dev/workPoe/*
/dev/workPara_n?/*
#
# Ignore sample storms (/testTrk and /testAns)
/storms/testTrk/*
/storms/testAns/*
#
# Ignore tar folders
/tar/*.gz
#
# Ignore GUI folders
/gui/exec/*.dll
/gui/exec/sloshGui.exe
/gui/exec/surf.ico
/gui/geodata/*.mrt
/gui/geodata/*.txt
/gui/geodata/colors.pal
/gui/geodata/landfall.pts
/gui/geodata/noaaball.gif
/gui/include/tcl8.5.3_win/*.h
/gui/include/tcl8.5.3_win/X11/*.h
/gui/lib/tcl8/8.5/*.tm
/gui/lib/tcl8.5/*
/gui/lib/tk8.5/*
