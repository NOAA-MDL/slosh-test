# Additions to the end of the default ~/.bash_profile (MSYS).

# Put your own programs (~/bin) first in the path
if [ -d "${HOME}/bin" ] ; then
  PATH="${HOME}/bin:${PATH}"
fi

# Also so it adds the /mingw32/bin for gcc 4.5.0
export OrigPath=".:$PATH"
alias setOrig='export PATH=$OrigPath'
nPath=$OrigPath
if [ -d "$HOME/mingw32/bin" ] ; then
   export Ming450Path=".:$HOME/mingw32/bin:$PATH"
   alias setMing450='export PATH=$Ming450Path'
   nPath=$Ming450Path
fi
export PATH=$nPath
