# Additions to the end of the default ~/.bashrc (MSYS).  The default file
# returns early for non-interactive shells, so these apply to interactive ones.

# Shell Options
#
# Native alternative to 'alias pwd' - forces shell built-in to resolve symlinks
set -o physical
#
# Make bash append rather than overwrite the history on disk
shopt -s histappend
#
# Check window size after command and update LINES and COLUMNS env variables.
shopt -s checkwinsize

# History Options
#
HISTSIZE=1000
HISTFILESIZE=2000
#
# Don't put duplicate lines in the history.
export HISTCONTROL=$HISTCONTROL${HISTCONTROL+:}ignoredups
#
# Ignore some controlling instructions (and the ls command as well)
export HISTIGNORE=$'[ \t]*:&:[fb]g:exit:ls'

# Aliases
#
# Interactive operation...
alias cp='cp -p'
alias mv='mv -i'
#
# Default to human readable figures
alias df='df -h'
alias du='du -h'
#
# Misc :)
alias grep='grep --color'                     # show differences in colour
alias vi='vim -p'                             # Load a vim tab per file
#
# Some shortcuts for different directory listings
alias ls='ls -v --color=auto -F --time-style=+"%Y-%m-%d %H:%M:%S"'
alias mpwd='a=$(cygpath -m $(pwd)) ; d=${a:0:1} ; echo "/${d,,}${a:2}"'
#
# Some aliases for git
alias gitdiff='git difftool -y --extcmd=/usr/bin/diff'
alias gitrevert='git checkout --'

# PS1 variable (adjust the prompt)
# In this case we first adjust the title with the current path, and then update
# the path.  PS1 uses the following variables: \u == User, \h == Host,
# \w == path of current directory, \t == time, \[ == start escape string,
# \] == end escape string
#
# For reference the original PS1 is:
# PS1="\[\e]0;\w\a\]\n\[\e[32m\]\u@\h \[\e[35m\]$MSYSTEM\[\e[0m\] \[\e[33m\]\w\[\e[0m\]\n\$ "
#-------------------------------------------------------------------------------
Title='\e]0;'     ; TitleEnd='\a'
green='\e[0;32m'  ; GREEN='\e[1;32m'
purple='\e[0;35m' ; PURPLE='\e[1;35m'
cyan='\e[0;36m'   ; CYAN='\e[1;36m'
yellow='\e[0;33m' ; YELLOW='\e[1;33m'
NC='\e[0m'
PS1="\[${Title}\w${TitleEnd}\]\[${green}\]\u@\h \[${purple}\]$MSYSTEM \[${cyan}\]\t \[${yellow}\]\w\[${NC}\]\n\$ "
